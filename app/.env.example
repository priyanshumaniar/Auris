# Copy this file to `.env` before running the app:
#
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows)
#
# Every value is optional. With an empty `.env`, Auris runs fully offline
# against the on-device SQLite database: no account server, no sync.
# `.env` is git-ignored; never commit real values.

# ---------------------------------------------------------------------------
# Cloud sync (optional)
# ---------------------------------------------------------------------------
# Fill both in to store records in your own Supabase project and sign in with
# Supabase Auth. Leave both blank for local-only mode.
#
# Find these under Project Settings -> API in the Supabase dashboard.
# Apply supabase/schema.sql to your project first: it creates the tables and
# the row-level security policies that limit every row to the signed-in
# user's own clinic. Full steps: docs/SUPABASE_SETUP.md.
#
# Use the ANON / PUBLISHABLE key only. It is designed to ship inside client
# apps and grants no access by itself. NEVER put the service_role key here:
# it bypasses row-level security entirely.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Clinic details for the header of every PDF report
# ---------------------------------------------------------------------------
# Used in local-only mode. In cloud mode reports carry the signed-in user's
# own clinic (set in the app), and these are only a fallback for an account
# with no clinic.
CLINIC_NAME=
CLINIC_ADDRESS=
CLINIC_PHONE=
